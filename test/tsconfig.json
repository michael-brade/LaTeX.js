{
  "extends": "../tsconfig.json",

  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },

  "include": [
    "**/*.ts",
    // ambient declarations (*.pegjs, *.ls, hypher, ...) for the source pulled in by "latex.js";
    // typeRoots only picks up packages (folders), not loose .d.ts files
    "../src/types/*.d.ts"
  ]
}