{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch LaTeX.js",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/bin/latex.js",
            "console": "integratedTerminal",
            "args": [
                "-b", "-m", "test/api/CustomMacros.ts"
            ]
        },
        {
            // mocha reads its options (tsx loader, setup files) from package.json
            "name": "mocha: current file",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "args": ["${file}", "--timeout", "0", "--grep", "${input:grep}"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "mocha: all tests",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "args": ["test/*.ts", "--timeout", "0", "--grep", "${input:grep}"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "inputs": [
        {
            "id": "grep",
            "type": "promptString",
            "description": "Only run tests whose full title matches this regex (empty: all)",
            "default": ""
        }
    ]
}
