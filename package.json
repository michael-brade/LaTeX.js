{
  "name": "latex.js",
  "description": "JavaScript LaTeX to HTML5 translator",
  "version": "0.13.0",
  "author": {
    "name": "Michael Brade",
    "email": "brade@kde.org"
  },
  "keywords": [
    "pegjs",
    "peggy",
    "latex",
    "parser",
    "html5"
  ],
  "bin": {
    "latex.js": "bin/latex.js"
  },
  "type": "module",
  "exports": {
    "latex.js-source": "./src/index.ts",
    "import": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/latex.js"
    },
    "require": {
      "types": "./dist/types/index.d.cts",
      "default": "./dist/latex.cjs"
    }
  },
  "browser": "./dist/latex.umd.cjs",
  "files": [
    "bin/latex.js",
    "dist/types/",
    "dist/latex.cjs",
    "dist/latex.cjs.map",
    "dist/latex.js",
    "dist/latex.js.map",
    "dist/latex.umd.cjs",
    "dist/latex.umd.cjs.map",
    "dist/css/",
    "dist/fonts/",
    "dist/js/",
    "dist/packages/",
    "dist/documentclasses/"
  ],
  "scripts": {
    "prepare": "patch-package && ln -sf ../typescript/bin/tsc node_modules/.bin/tsc ;",
    "clean": "rimraf dist bin test/coverage docs/.vitepress/.temp docs/.vitepress/cache ; git worktree remove --force website 2>/dev/null; git worktree prune; rimraf website .website.git ;",
    "assets": "mkdirp dist/css dist/js dist/fonts dist/documentclasses dist/packages && touch dist/documentclasses/.keep dist/packages/.keep && rsync -a src/css/ dist/css/ && rsync -a public/fonts/ dist/fonts/ && rsync -a node_modules/katex/dist/fonts/*.woff2 dist/fonts/ && node lib/katex-css.mjs dist && rsync -a public/js/ dist/js/ ;",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && node lib/vue-tsc.cjs --noEmit -p docs/.vitepress ;",
    "devbuild": "vite build --mode development && vite build -c vite.cli.config.ts --mode development && npm run assets ;",
    "build": "vite build --mode production && vite build -c vite.cli.config.ts --mode production && npm run assets ;",
    "devdocs": "vitepress dev docs;",
    "docs": "npm run build && { [ -d website ] || { git worktree prune && git worktree add website gh-pages; }; } && mv website/.git .website.git && ( vitepress build docs; status=$?; mv .website.git website/.git; exit $status ) && cd website && git add . && { git diff --cached --quiet || git commit -m 'regenerated website'; } ;",
    "test": "vitest run;",
    "testc": "vitest run --coverage;",
    "test-int": "test/integration/pack.sh && test/integration/consumer.sh && test/integration/react.sh ;"
  },
  "dependencies": {
    "commander": "8.x",
    "he": "2.x",
    "fs-extra": "11.4.x",
    "js-beautify": "2.0.x",
    "svgdom": "^0.1.29",
    "hyphen": "1.14.x"
  },
  "devDependencies": {
    "patch-package": "8.0.x",
    "js-yaml": "5.x",
    "katex": "0.19.x",
    "@svgdotjs/svg.js": "3.2.x",
    "peggy": "5.1.x",
    "mkdirp": "3.x",
    "rimraf": "6.x",
    "typescript": "7.0.x",
    "@typescript/typescript6": "6.0.x",
    "tsx": "^4.22.4",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.7",
    "vitepress": "^1.6.4",
    "split-grid": "1.0.x",
    "@codemirror/autocomplete": "6.x",
    "@codemirror/commands": "6.x",
    "@codemirror/language": "6.x",
    "@codemirror/lint": "6.x",
    "@codemirror/search": "6.x",
    "@codemirror/state": "6.x",
    "@codemirror/view": "6.x",
    "@codemirror/theme-one-dark": "6.x",
    "codemirror-lang-latex": "0.6.x",
    "vue-tsc": "3.3.x",
    "vue-codemirror6": "1.5.x",
    "sass-embedded": "1.108.x",
    "vite": "8.3.x",
    "vite-plugin-node-polyfills": "0.28.x",
    "vite-plugin-checker": "1.0.x",
    "unplugin-dts": "1.1.x",
    "rollup-plugin-visualizer": "7.1.x",
    "@rolldown/plugin-babel": "0.3.x",
    "@babel/plugin-proposal-decorators": "8.0.x",
    "vitest": "5.1.x",
    "@vitest/coverage-v8": "5.1.x",
    "slugify": "1.6.x",
    "puppeteer": "25.17.x",
    "pixelmatch": "8.x",
    "pngjs": "7.0.x",
    "@types/pngjs": "^6.0.5",
    "serve-handler": "6.x",
    "@types/serve-handler": "^6.1.4",
    "@types/he": "^1.2.3",
    "@types/hyphen": "1.14.x",
    "@types/svgdom": "^0.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/js-beautify": "^1.14.3"
  },
  "puppeteer": {
    "chrome": {
      "skipDownload": false
    },
    "firefox": {
      "skipDownload": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-brade/LaTeX.js.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/michael-brade/LaTeX.js/issues"
  },
  "homepage": "https://latex.js.org",
  "engines": {
    "node": ">= 22.0"
  }
}
