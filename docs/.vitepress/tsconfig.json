{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": false,

        "isolatedModules": true,
        "skipLibCheck": true,

        "paths": {
            // must be in sync with aliases in config.ts
            "@theme/components/*": ["./theme/components/*"],
            "@theme/Layout.vue": ["./theme/Layout.vue"]
        }
    },
    "include": [
        "vite-env.d.ts",
        "config.ts",
        "**/*.vue",
        "**/*.md",
        "**/*.ts",
        "../components/**/*.vue",
        "../components/**/*.ts"
    ]
}
