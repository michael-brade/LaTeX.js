# also the image of the CI test job, which passes its own NODE_VERSION (see .github/workflows/node.js.yml)
ARG NODE_VERSION=24.22

FROM node:${NODE_VERSION}-trixie

# disable Debian's built-in docker-clean scripts so the cache mounts actually persist
RUN rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-debs; \
    echo 'APT::Keep-Downloaded-Packages "true";' >> /etc/apt/apt.conf.d/keep-debs;

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --fix-missing --no-install-recommends \
    git \
    moreutils \
    less \
    rsync \
    neovim \
    htop \
    # for chrome in puppeteer
    libnspr4 libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 \
    libxkbcommon0 libasound2t64 libgbm1 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    # for firefox in puppeteer
    libgtk-3-0t64

ADD --checksum=sha256:4c3e7440c3ebf94b0d5a67d3add25b9a40897c7f14678ecdb5db3c7b77ff816f \
    https://github.com/oxipng/oxipng/releases/download/v10.2.1/oxipng_10.2.1-1_amd64.deb \
    /tmp/

RUN dpkg -i /tmp/oxipng_10.2.1-1_amd64.deb

RUN curl -fsSL https://qlty.sh | QLTY_INSTALL_BIN_PATH=/usr/local/bin sh \
    && rm -rf /root/.qlty
