{
    "name": "LaTeX.js",

    "build": {
        "dockerfile": "Containerfile",
        "context": "..",
        "options": [
            "--progress=plain"
        ],
        "args": {
            // "baseImageVersion": "lts"
        }
    },
    "features": {
        "ghcr.io/michael-brade/devcontainer-features/essential-tools:1.0": {},
        "ghcr.io/michael-brade/devcontainer-features/bash-aliases:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
        "./features/opencode": {}
    },

    "runArgs": [
        "--name", "LaTeX.js-${devcontainerId}",
        // "--network=host",
        // allow access to host via 'host.docker.internal' in the container
        "--add-host=host.docker.internal:host-gateway"
    ],

    // "capAdd": ["SYS_PTRACE"],
    // "securityOpt": ["seccomp=unconfined"],

    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    "containerUser": "node",
    "containerEnv": { },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-containers",
                "EditorConfig.EditorConfig",
                "maattdd.gitless",
                "PeggyJS.peggy-language",
                "Vue.volar",
                "kamikillerto.vscode-colorize",
                "dbaeumer.vscode-eslint",
                "vitest.explorer",
                "ms-vscode.hexeditor",
                "timonwong.shellcheck"
            ]
        }
    },

    "mounts": [
        {
            "source": "/etc/localtime",
            "target": "/etc/localtime",
            "type": "bind"
        },

        // this is to protect the .git directory
        {
            "source": "${localWorkspaceFolder}/.git",
            "target": "/source/.git",
            "type": "bind,readonly"
        },

        {
            "source": "claude-code-config",
            "target": "/home/node/.claude",
            "type": "volume"
        }
    ]
}
