- in the unit tests: check the (serialized) html for validity

import { HtmlValidate } from "html-validate";

const htmlvalidate = new HtmlValidate({
  extends: ["html-validate:recommended"],
});

const report = await htmlvalidate.validateString("<p><div>invalid</div></p>");

console.log(report.valid); // false
console.log(report.results[0].messages);


